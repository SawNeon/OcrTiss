# Copie para .env na VPS e preencha. Este arquivo é só referência.

# Acesso à tela. Sem isso o serviço fica aberto na internet.
AUTH_USER=atendente
AUTH_PASSWORD=troque-por-uma-senha-forte

# Leitura local por gabarito: funciona sem nuvem.
TEMPLATE_READER_ENABLED=true

# Leitura de texto livre por modelo de visão. Ligar envia a imagem da guia
# para a OpenAI: só habilite com a decisão de compliance tomada.
LLM_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

RENDER_DPI=300
